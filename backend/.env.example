# Variabel environment untuk ColorRush Backend
# Copy file ini ke server dan isi nilainya

# === WEBHOOK (wajib diisi) ===
# Secret yang sama dengan yang kamu set di GitHub Webhook settings
WEBHOOK_SECRET=ganti_dengan_secret_rahasia_kamu

# === WEBHOOK OPTIONAL ===
WEBHOOK_PORT=9000
REPO_PATH=/www/wwwroot/colorrush-backend
BRANCH=main
PM2_NAME=colorrush-server

# === SERVER OPTIONAL ===
PORT=9001
