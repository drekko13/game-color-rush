{
  "name": "color-clash",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"VITE,NODE_SERVER\" -c \"cyan,green\" \"vite\" \"node --watch server/index.js\"",
    "client": "vite",
